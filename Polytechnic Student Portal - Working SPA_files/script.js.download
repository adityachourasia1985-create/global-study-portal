function searchNotice() {

    const input = document.getElementById("noticeSearch").value.toLowerCase();

    const notices = document.querySelectorAll(".notice-item");

    notices.forEach((notice) => {

        if (notice.innerText.toLowerCase().includes(input)) {
            notice.style.display = "block";
        } else {
            notice.style.display = "none";
        }

    });

}
let attendanceData = [];
function addAttendance(){

    const subject = document.getElementById("subjectName").value;
    const total = document.getElementById("totalClasses").value;
    const attended = document.getElementById("attendedClasses").value;

    if(subject === "" || total === "" || attended === ""){
        alert("Please fill all fields");
        return;
    }

    const percentage = Math.round((attended / total) * 100);

    attendanceData.push({
        subject: subject,
        total: total,
        attended: attended,
        percentage: percentage
    });

    alert("Subject Added Successfully");

    console.log(attendanceData);
}
function addAttendance(){

    const subject = document.getElementById("subjectName").value;
    const total = Number(document.getElementById("totalClasses").value);
    const attended = Number(document.getElementById("attendedClasses").value);

    if(subject === "" || total <= 0 || attended < 0){
        alert("Please fill correct details");
        return;
    }

    const percentage = Math.round((attended / total) * 100);


    const table = document.getElementById("attendanceTable");


    table.innerHTML += `
        <tr>
            <td>${subject}</td>
            <td>${total}</td>
            <td>${attended}</td>
            <td>${percentage}%</td>
            <td>
                <button onclick="this.parentElement.parentElement.remove()">
                    Delete
                </button>
            </td>
        </tr>
    `;


    document.getElementById("subjectName").value = "";
    document.getElementById("totalClasses").value = "";
    document.getElementById("attendedClasses").value = "";

}

    const semester =
        document.getElementById("semester").value;

    const mobileNumber =
        document.getElementById("mobileNumber").value;

    const studentEmail =
        document.getElementById("studentEmail").value;

    if (
        enrollmentNumber === "" ||
        branch === "" ||
        semester === "" ||
        mobileNumber === "" ||
        studentEmail === ""

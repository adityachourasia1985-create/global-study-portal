irmation and safety requirements.\"],\"enable_p13n_in_api_tool\":true,\"api_tool_default_on\":true},\"id_type\":\"userID\",\"is_device_based\":false,\"group_name\":\"api tool only\",\"is_experiment_active\":true,\"is_user_in_experiment\":true,\"allocated_experiment_name\":\"2949247971\",\"explicit_parameters\":[\"migrate_p13n\",\"enable_p13n_in_api_tool\",\"enable_patcher_api_tool_v2\",\"prompt_insertion_array\",\"api_tool_default_on\"],\"undelegated_secondary_exposures\":[{\"gate\":\"2606147622\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1332044836\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1743677773\",\"gateValue\":\"false\",\"ruleID\":\"default\"}]},\"3363338405\":{\"name\":\"3363338405\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"value\":{\"default_preset_index\":0},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"1578749296\":{\"name\":\"1578749296\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"value\":{\"is_sticky_toggle_off\":false,\"is_trinity\":false,\"sidebar-experiment-treatment\":\"disabled\",\"enable-closed-sidebar\":false,\"enable-minimized-sidebar\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"explicit_parameters\":[],\"undelegated_secondary_exposures\":[]},\"823322201\":{\"name\":\"823322201\",\"rule_id\":\"3JedmX4Jheyqr19lbM2Ta5\",\"secondary_exposures\":[{\"gate\":\"3865988848\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1090231883\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":3,\"value\":{\"enabled\":false},\"id_type\":\"userID\",\"is_device_based\":false,\"group_name\":\"Control\",\"is_experiment_active\":true,\"is_user_in_experiment\":true,\"allocated_experiment_name\":\"3568522964\",\"explicit_parameters\":[\"enabled\"],\"undelegated_secondary_exposures\":[{\"gate\":\"3865988848\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1090231
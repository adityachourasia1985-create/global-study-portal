,\"id_type\":\"userID\",\"value\":{\"is_enabled\":false},\"is_device_based\":false,\"is_in_layer\":true,\"explicit_parameters\":[\"is_enabled\"],\"group_name\":\"Test\",\"is_experiment_active\":true,\"is_user_in_experiment\":true},\"2391622925\":{\"name\":\"2391622925\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":10,\"id_type\":\"userID\",\"value\":{\"configuration_url\":\"https://chatgpt.com/admin\",\"self_serve_business_access_token_creation_enabled\":true,\"use_backend_generated_jwt\":true},\"is_device_based\":false,\"passed\":false},\"3747383021\":{\"name\":\"3747383021\",\"rule_id\":\"3d0IY8dczWoLtIoPlDtxHk:100.00:1\",\"secondary_exposures\":[{\"gate\":\"733205176\",\"gateValue\":\"false\",\"ruleID\":\"1PJvsr1PFO2C35xU6YPcnd\"}],\"version\":181,\"id_type\":\"stableID\",\"value\":{\"teams\":true,\"google_calendar\":true,\"notion\":true,\"mcp\":false,\"linear\":true,\"canva\":true,\"gmail\":true,\"slack\":true,\"outlook_email\":true,\"dropbox\":true,\"sharepoint\":true,\"github\":true,\"google_drive\":true,\"outlook_calendar\":true,\"box\":true,\"hubspot\":true},\"is_device_based\":true,\"passed\":true},\"3608673692\":{\"name\":\"3608673692\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"sse_initial_open_timeout_ms\":0,\"sse_between_bytes_timeout_ms\":60000,\"sse_first_response_warning_ms\":120000},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"user_prompt_key\":\"good_option\",\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\"},\"is_device_based\":false,\"passed\":false},\"1351205191\":{\"name\":\"1351205191\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"2452207111\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1933899113\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"1294748579\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":79,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"550560761\":{\"name\":\"550560761\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"local_results_limit\":2,\"history_results_limit\":6},\"is_device_based\":false,\"passed\":false},\"217573384\":{\"name\":\"217573384\",\"rule_id\":\"prestart\",\"secondary_exposures\":[],\"version\":21,\"id_type\":\"userID\",\"value\":{},\"is_device_